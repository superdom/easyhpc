apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
    uid: prometheus
{% if loki_enabled | default(false) %}
  - name: Loki
    type: loki
    access: proxy
    url: "{{ loki_url | default('http://localhost:3100') }}"
    isDefault: false
    editable: false
    uid: loki
{% endif %}
