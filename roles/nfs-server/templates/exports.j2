# /etc/exports - generated by EasyHPC

{% for export in nfs_exports | default([]) %}
{% if export.options is defined %}
{{ export.path }} {{ export.options }}
{% else %}
{%- set trusted_ips = [] -%}
{%- for h in export.trusted_clients | default([]) -%}
{%-   set _ = trusted_ips.append(hostvars[h].ansible_host if h in hostvars and hostvars[h].ansible_host is defined else h) -%}
{%- endfor -%}
{%- set squash_ips = [] -%}
{%- for h in export.root_squash_clients | default([]) -%}
{%-   set _ = squash_ips.append(hostvars[h].ansible_host if h in hostvars and hostvars[h].ansible_host is defined else h) -%}
{%- endfor -%}
{%- set trusted_unique = trusted_ips | unique | list -%}
{%- set squash_unique = (squash_ips | unique | list) | reject('in', trusted_unique) | list -%}
{% if (trusted_unique + squash_unique) | length > 0 %}
{{ export.path }}{% for ip in trusted_unique %} {{ ip }}(rw,sync,no_root_squash,no_subtree_check){% endfor %}{% for ip in squash_unique %} {{ ip }}(rw,sync,root_squash,no_subtree_check){% endfor %}
{% endif %}
{% endif %}

{% endfor %}
