services:
  dcgm-exporter:
    image: nvcr.io/nvidia/k8s/dcgm-exporter:{{ dcgm_exporter_version | default('3.3.0') }}
    container_name: dcgm-exporter
    restart: unless-stopped
    gpus: all
    ports:
      - "{{ dcgm_exporter_port }}:9400"
    volumes:
      - /run/prometheus:/run/prometheus:rw
    privileged: true
    environment:
      - DCGM_EXPORTER_LISTEN=:9400
