FROM golang:1.21-alpine AS builder

WORKDIR /build

# Install git
RUN apk add --no-cache git

# Clone and build slurm-exporter
RUN git clone https://github.com/vpenso/prometheus-slurm-exporter.git . && \
    go build -o slurm_exporter

FROM alpine:latest

RUN apk --no-cache add ca-certificates
WORKDIR /root/

COPY --from=builder /build/slurm_exporter .

EXPOSE 8080

ENTRYPOINT ["./slurm_exporter"]
CMD ["--listen-address=0.0.0.0:8080"]

