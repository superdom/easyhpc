# GPU Resource Configuration (GRES)
# Generated by Ansible - EasyHPC
#
# Configuration priority:
# 1. Manual: slurm_gres_config list (if defined)
# 2. AutoDetect: NVML auto-detection (recommended for GPU clusters)
# 3. Topology: ansible_local.topology.gpu_topology facts
# 4. Count: gpu_count host variable
#
# To use NVML auto-detection, set in group_vars or inventory:
#   slurm_autodetect_nvml: true
# Or enable configless mode with GPU nodes present.
#
# For manual configuration, define slurm_gres_config:
#   slurm_gres_config:
#     - Name: gpu
#       File: /dev/nvidia0
#       Type: a100

{% if slurm_gres_config | default([]) | length > 0 %}
# === Manual GRES configuration (slurm_gres_config) ===
{% for gres in slurm_gres_config %}
{% for key, value in gres.items() %}
{{ key }}={{ value }}
{% endfor %}

{% endfor %}
{% else %}
{# Determine if any node in the cluster has GPUs #}
{% set cluster_gpu_nodes = [] %}
{% if groups['slurm-node'] is defined %}
{% for host in groups['slurm-node'] %}
{% set host_facts = hostvars[host].get('ansible_facts', {}) %}
{% set topology_data = host_facts.get('ansible_local', {}).get('topology', {}) %}
{% set host_gpu_topology = topology_data.get('gpu_topology', []) %}
{% set host_gpu_count = hostvars[host].get('gpu_count', 0) | int %}
{% if host_gpu_count > 0 or (host_gpu_topology | length) > 0 %}
{% set _ = cluster_gpu_nodes.append(host) %}
{% endif %}
{% endfor %}
{% endif %}
{% set cluster_has_gpu = cluster_gpu_nodes | length > 0 %}

{# Determine effective auto-detect mode #}
{# AutoDetect is enabled if:                                                    #}
{#   1. slurm_autodetect_nvml is explicitly true, OR                           #}
{#   2. configless mode is enabled AND cluster has GPU nodes                   #}
{% set autodetect_nvml_effective = (slurm_autodetect_nvml | default(false)) or ((slurm_configless_enabled | default(false) | bool) and cluster_has_gpu) %}

{% if autodetect_nvml_effective %}
# === NVML Auto-Detection enabled ===
# Slurm will automatically detect GPU resources using NVML library.
# Requires: NVIDIA driver with libnvidia-ml installed.
AutoDetect=nvml
{% else %}
{# Fallback to topology facts or gpu_count variable #}
{% set local_facts = hostvars[inventory_hostname].get('ansible_facts', {}) %}
{% set topology_data = local_facts.get('ansible_local', {}).get('topology', {}) %}
{% set gpu_topology = topology_data.get('gpu_topology', []) %}

{% if gpu_topology | length > 0 %}
# === GPU topology from ansible_local facts ===
# Source: ansible_local.topology.gpu_topology
{% for affinity in gpu_topology %}
Name=gpu File=/dev/nvidia{{ loop.index0 }} Cores={{ affinity }}
{% endfor %}
{% elif gpu_count is defined and gpu_count | int > 0 %}
# === GPU configuration from gpu_count variable ===
# Source: host variable gpu_count={{ gpu_count }}
{% for device in range(0, gpu_count | int) %}
Name=gpu File=/dev/nvidia{{ device }}{% if gpu_type is defined %} Type={{ gpu_type }}{% endif %}

{% endfor %}
{% else %}
# No GPU resources detected on this node ({{ inventory_hostname }})
# To enable GPU support:
#   1. Set slurm_autodetect_nvml: true for NVML auto-detection, OR
#   2. Define gpu_count host variable, OR
#   3. Provide ansible_local.topology.gpu_topology facts, OR
#   4. Define slurm_gres_config manually
{% endif %}
{% endif %}
{% endif %}
