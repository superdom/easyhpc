#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="${1:-}"

if [[ -z "${RUN_DIR}" || ! -d "${RUN_DIR}" ]]; then
  exit 0
fi

shopt -s nullglob
for script in "${RUN_DIR}/"*; do
  if [[ -f "${script}" && -x "${script}" ]]; then
    logger -s -t slurm-runparts -- "running ${script}"
    "${script}"
  fi
done
