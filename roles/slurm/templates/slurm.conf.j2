# Slurm Configuration File
# Generated by Ansible

# Cluster / Controller
{% if slurm_config.ClusterName is defined %}
ClusterName={{ slurm_config.ClusterName }}
{% else %}
ClusterName={{ cluster_name | default('easyhpc-cluster') }}
{% endif %}

{% if slurm_config.SlurmctldHost is defined %}
{% set configured_slurmctld_host = slurm_config.SlurmctldHost %}
{% else %}
{% set configured_slurmctld_host = groups['slurm-controller'][0] | default('localhost') %}
{% endif %}

{% set ctld_hosts = slurmctld_hosts | default(groups['slurm-controller'] | default([])) %}
{% set ha_mode = slurm_ha_enabled | default(false) | bool %}

{% if ha_mode %}
{% for host in ctld_hosts %}
SlurmctldHost={{ host }}
{% endfor %}
{% else %}
SlurmctldHost={{ configured_slurmctld_host }}
{% if slurm_backup_controller is defined and slurm_backup_controller != '' and slurm_backup_controller != configured_slurmctld_host %}
BackupController={{ slurm_backup_controller }}
{% endif %}
{% endif %}

# Core Identity / Ports
{% for key in ['SlurmUser', 'SlurmctldPort', 'SlurmdPort'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Auth / Security
{% for key in ['AuthType'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Paths / Logs / PID
{% for key in ['SlurmctldLogFile', 'SlurmdLogFile', 'SlurmctldPidFile', 'SlurmdPidFile', 'StateSaveLocation', 'SlurmdSpoolDir', 'PluginDir', 'PlugStackConfig', 'JobCompLoc'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Scheduler / Select
{% for key in ['SchedulerType', 'SelectType', 'SelectTypeParameters'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Cgroup / Task / Proc
{% for key in ['ProctrackType', 'TaskPlugin', 'JobAcctGatherType', 'JobAcctGatherFrequency'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Accounting
{% for key in ['AccountingStorageType', 'AccountingStorageHost', 'AccountingStorageUser', 'JobCompType'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Debug / Tuning
{% for key in ['SlurmctldDebug', 'SlurmdDebug', 'SlurmctldParameters', 'SlurmdParameters', 'SlurmctldTimeout', 'SlurmdTimeout'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

# Gres / Prolog / Epilog
{% for key in ['GresTypes', 'Prolog', 'Epilog'] %}
{% if slurm_config[key] is defined %}
{{ key }}={{ slurm_config[key] }}
{% endif %}
{% endfor %}

{% set printed_keys = [
  'ClusterName',
  'SlurmctldHost',
  'SlurmUser',
  'SlurmctldPort',
  'SlurmdPort',
  'AuthType',
  'SlurmctldLogFile',
  'SlurmdLogFile',
  'SlurmctldPidFile',
  'SlurmdPidFile',
  'StateSaveLocation',
  'SlurmdSpoolDir',
  'PluginDir',
  'PlugStackConfig',
  'JobCompLoc',
  'SchedulerType',
  'SelectType',
  'SelectTypeParameters',
  'ProctrackType',
  'TaskPlugin',
  'JobAcctGatherType',
  'JobAcctGatherFrequency',
  'AccountingStorageType',
  'AccountingStorageHost',
  'AccountingStorageUser',
  'JobCompType',
  'SlurmctldDebug',
  'SlurmdDebug',
  'SlurmctldParameters',
  'SlurmdParameters',
  'SlurmctldTimeout',
  'SlurmdTimeout',
  'GresTypes',
  'Prolog',
  'Epilog'
] %}
{% set ns = namespace(other_section=false) %}
{% for key, value in slurm_config.items() %}
{% if key not in printed_keys and key not in ['AccountingStoragePass'] %}
{% if not ns.other_section %}
# Other
{% set ns.other_section = true %}
{% endif %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}

# Compute Nodes
{% if slurm_nodes | default([]) | length > 0 %}
{% for node in slurm_nodes %}
NodeName={{ node.name }}{% for key, value in node.items() %}{% if key != 'name' %} {{ key }}={{ value }}{% endif %}{% endfor %}

{% endfor %}
{% else %}
# Auto-detect nodes from inventory
{% if groups['slurm-node'] is defined and groups['slurm-node'] | length > 0 %}
{% for host in groups['slurm-node'] %}
{% set host_facts = hostvars[host].get('ansible_facts', {}) %}
{% set hostname = host_facts.get('hostname', host) | default(host) %}
{% set processor_vcpus = host_facts.get('processor_vcpus', 0) | int %}
{% set processor_count = host_facts.get('processor_count', 0) | int %}
{% set processor_cores = host_facts.get('processor_cores', 0) | int %}
{% if processor_vcpus > 0 %}
{% set cpus = processor_vcpus %}
{% elif processor_count > 0 and processor_cores > 0 %}
{% set cpus = processor_count * processor_cores %}
{% else %}
{% set cpus = 1 %}
{% endif %}
{% set memory = host_facts.get('memtotal_mb', 1024) | default(1024) | int %}
{% set processor_count_actual = host_facts.get('processor_count', 0) | int %}
{% set processor_cores_actual = host_facts.get('processor_cores', 0) | int %}
{% if processor_count_actual > 0 and processor_cores_actual > 0 %}
{% set sockets = processor_count_actual %}
{% set cores_per_socket = processor_cores_actual %}
{% set threads_per_core = (cpus / (sockets * cores_per_socket)) | int %}
{% if threads_per_core < 1 %}
{% set threads_per_core = 1 %}
{% endif %}
{% else %}
{% set sockets = 1 %}
{% set cores_per_socket = cpus %}
{% set threads_per_core = 1 %}
{% endif %}
{% set topology_data = host_facts.get('ansible_local', {}).get('topology', {}) %}
{% set gpu_topology = topology_data.get('gpu_topology', []) %}
{% set inventory_gpu_count = hostvars[host].get('gpu_count', 0) | int %}
{% set detected_gpu_count = gpu_topology | length %}
{% set effective_gpu_count = detected_gpu_count if detected_gpu_count > 0 else inventory_gpu_count %}
NodeName={{ hostname }} CPUs={{ cpus }} Boards=1 SocketsPerBoard={{ sockets }} CoresPerSocket={{ cores_per_socket }} ThreadsPerCore={{ threads_per_core }} RealMemory={{ memory }}{% if effective_gpu_count > 0 %} Gres=gpu:{{ effective_gpu_count }}{% endif %}

{% endfor %}
{% else %}
NodeName=localhost CPUs=1 RealMemory=1024
{% endif %}
{% endif %}

# Partitions
{% for partition in slurm_partitions | default([{'name': 'debug', 'Nodes': 'ALL', 'Default': 'YES', 'MaxTime': 'UNLIMITED', 'State': 'UP'}]) %}
PartitionName={{ partition.name }}{% for key, value in partition.items() %}{% if key != 'name' %} \
    {{ key }}={{ value }}{% endif %}{% endfor %}

{% endfor %}
