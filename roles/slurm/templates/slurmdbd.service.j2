[Unit]
Description=SLURM database daemon
Documentation=man:slurmdbd(8)
After=network.target munge.service mysql.service mariadb.service
ConditionPathExists=/etc/slurm/slurmdbd.conf
Wants=munge.service

[Service]
Type=simple
ExecStart={{ slurm_install_prefix }}/sbin/slurmdbd -D -s
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300
LimitNOFILE=65536
LimitMEMLOCK=infinity
TasksMax=infinity
RuntimeDirectory=slurm
RuntimeDirectoryMode=0755
User={{ slurm_user.name }}
Group={{ slurm_user.group }}

[Install]
WantedBy=multi-user.target

